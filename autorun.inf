; Aegis Laptop Diagnostics - USB Portable Autorun (Windows)
; -------------------------------------------------------
; When Aegis is installed on a USB drive, Windows will show
; an AutoPlay prompt offering to "Run Aegis Diagnostics".
; This file is ignored on Linux/macOS (safe to have present).
;
; SECURITY NOTE: autorun.inf is disabled by default in Windows 7+.
; The USB AutoPlay prompt requires the user to click "Allow" — no
; silent execution occurs without user consent.

[autorun]
open=start-aegis.bat
icon=aegis.ico
label=Aegis Laptop Diagnostics
action=Run Aegis Laptop Diagnostics
