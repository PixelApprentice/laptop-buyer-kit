<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Aegis Laptop Diagnostics - Windows Application Manifest
  --------------------------------------------------------
  This manifest requests UAC Administrator elevation so that
  Aegis can read hardware telemetry registers that require
  elevated privileges (e.g., SMART/NVMe data via Windows WMI,
  thermal sensor reads via OpenHardwareMonitor APIs).

  The user sees a standard Windows UAC prompt — no silent elevation.
  Aegis does NOT write files, modify registry, or make network calls.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
    version="2.1.0.0"
    processorArchitecture="*"
    name="AegisLaptopDiagnostics"
    type="win32"
  />
  <description>Aegis Laptop Diagnostics — Offline Hardware Assurance</description>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!-- requireAdministrator: needed for SMART/NVMe access without third-party driver -->
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
    </application>
  </compatibility>
</assembly>
